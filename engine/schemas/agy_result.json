{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["changed_files", "diagnosis", "confidence"],
  "properties": {
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnosis": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
